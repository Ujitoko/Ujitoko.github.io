  <url>
    <loc>https://ujitoko.github.io/en/</loc>
    <priority>1.0</priority>
    <xhtml:link rel="alternate" hreflang="ja" href="https://ujitoko.github.io/"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://ujitoko.github.io/en/"/>
  </url>
  <url>
    <loc>https://ujitoko.github.io/project/touch_desire/</loc>
    <priority>0.8</priority>
    <xhtml:link rel="alternate" hreflang="ja" href="https://ujitoko.github.io/project/touch_desire/"/>
